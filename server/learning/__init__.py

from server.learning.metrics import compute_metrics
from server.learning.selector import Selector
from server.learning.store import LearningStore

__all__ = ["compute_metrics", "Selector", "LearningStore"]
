from __future__ import annotations

import sqlite3
from pathlib import Path

DB_PATH = Path("bench") / "learning.sqlite3"


class LearningStore:
    """SQLite-backed run store for metrics and feedback."""

    def __init__(self, db_path: str | Path | None = None) -> None:
        self.db_path = Path(db_path) if db_path is not None else DB_PATH
        self.db_path.parent.mkdir(parents=True, exist_ok=True)
        self._initialize()

    def _initialize(self) -> None:
        with sqlite3.connect(self.db_path) as conn:
            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS runs (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    input_hash TEXT,
                    config_json TEXT,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
                """
            )
            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS feedback (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    run_id INTEGER,
                    choice TEXT,
                    notes TEXT,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
                """
            )
            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS metrics (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    run_id INTEGER,
                    seam_score REAL,
                    fidelity_lpips REAL,
                    vector_ssim REAL,
                    latency_ms REAL,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
                """
            )
            conn.commit()

    def record_run(self, input_hash: str, config_json: str) -> int:
        with sqlite3.connect(self.db_path) as conn:
            cursor = conn.execute(
                "INSERT INTO runs (input_hash, config_json) VALUES (?, ?)",
                (input_hash, config_json),
            )
            conn.commit()
            return int(cursor.lastrowid)

    def record_feedback(self, run_id: int, choice: str, notes: str = "") -> None:
        with sqlite3.connect(self.db_path) as conn:
            conn.execute(
                "INSERT INTO feedback (run_id, choice, notes) VALUES (?, ?, ?)",
                (run_id, choice, notes),
            )
            conn.commit()

    def record_metrics(self, run_id: int, seam_score: float, fidelity_lpips: float, vector_ssim: float, latency_ms: float) -> None:
        with sqlite3.connect(self.db_path) as conn:
            conn.execute(
                "INSERT INTO metrics (run_id, seam_score, fidelity_lpips, vector_ssim, latency_ms) VALUES (?, ?, ?, ?, ?)",
                (run_id, seam_score, fidelity_lpips, vector_ssim, latency_ms),
            )
            conn.commit()


store = LearningStore()
